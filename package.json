{
  "name": "kerf-your-enthusiasm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn main:app --port 8001",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:optimizer && npm run test:parts && npm run test:layout-units",
    "test:layout-units": "tsx --tsconfig tsconfig.json src/features/cut-planning/domain/units.test.ts",
    "test:optimizer": "tsx --tsconfig tsconfig.json src/lib/cut-optimizer.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:demo": "tsx --tsconfig tsconfig.json scripts/seed-demo.ts",
    "test:db": "tsx --tsconfig tsconfig.json src/db/postgres.test.ts",
    "test:parts": "tsx --tsconfig tsconfig.json src/features/cut-lists/domain/parts.test.ts"
  },
  "dependencies": {
    "@next/env": "^16.2.12",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "konva": "^10.2.3",
    "maxrects-packer": "^2.7.3",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "^19.2.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
