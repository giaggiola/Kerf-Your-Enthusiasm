# Copy to .env (docker compose) or .env.local (npm run dev), then fill in.

# Better-Auth signing secret — must be at least 32 characters or the server
# refuses to start. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. Has to match the host on the Google redirect URI.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist of Google accounts permitted to sign in. Anyone
# else is refused at sign-up and on every request. Leaving this unset in
# production locks everybody out — deliberately fails closed rather than open.
ALLOWED_EMAILS=

# Optional local development login. Ignored outside `next dev`.
ENABLE_DEV_LOGIN=false

# PostgreSQL database managed by Coolify. Use its internal connection URL for
# deployed containers, or a localhost port mapping for local development.
DATABASE_URL=postgresql://kerf:replace-with-database-password@127.0.0.1:55432/kerf

# Uploaded STEP files still need persistent storage (use /data/step-files in Docker).
STEP_STORAGE_DIR=./data/step-files

# STEP/CNC backend (FastAPI + CadQuery). Only needed for STEP file import.
FASTAPI_URL=http://127.0.0.1:8001
